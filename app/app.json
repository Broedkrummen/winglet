{
  "expo": {
    "name": "Winglet",
    "slug": "winglet",
    "version": "0.9.0",
    "scheme": "winglet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.vikasrp24.winglet"
    },
    "android": {
      "package": "io.github.vikasrp24.winglet",
      "adaptiveIcon": {
        "backgroundColor": "#5B4BD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Winglet",
      "shortName": "Winglet",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Winglet uses the camera to scan the pairing QR code from your server.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Winglet lets you pick photos and videos to send to your agent.",
          "cameraPermission": "Winglet uses the camera to take a photo to send to your agent.",
          "microphonePermission": "Winglet records a voice note while you hold the mic button."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Winglet uses the microphone for voice notes and hands-free voice after you tap to start. Recording stops when you leave the foreground.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Winglet can ask for Face ID to unlock when App lock is on."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*",
            "audio/*",
            "application/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "audio/*",
            "application/*"
          ],
          "disableIOS": true
        }
      ]
    ]
  }
}
